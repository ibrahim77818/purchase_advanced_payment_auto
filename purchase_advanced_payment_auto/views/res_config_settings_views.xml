<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_purchase_advance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.advance.payment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='invoicing_settings_container']" position="after">
                <block title="Advance Payment" name="purchase_advance_payment_container">
                    <setting id="purchase_advance_payment_setting" company_dependent="1"
                             string="Vendor Advance Payments"
                             help="Register advance payments on confirmed purchase orders and deduct them proportionally on vendor bills">
                        <field name="purchase_advance_payment_enabled"/>
                        <div class="content-group" invisible="not purchase_advance_payment_enabled">
                            <div class="row mt16">
                                <label for="purchase_advance_product_id" string="Product" class="col-lg-4 o_light_label"/>
                                <field name="purchase_advance_product_id"
                                       context="{'default_type': 'service', 'default_purchase_ok': True, 'default_sale_ok': False}"
                                       required="purchase_advance_payment_enabled"/>
                            </div>
                            <div class="row">
                                <label for="purchase_advance_account_id" string="Prepayment Account" class="col-lg-4 o_light_label"/>
                                <field name="purchase_advance_account_id"
                                       options="{'no_create': True}"
                                       required="purchase_advance_payment_enabled"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
