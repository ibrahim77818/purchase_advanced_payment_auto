<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_advance_payment_wizard_view_form" model="ir.ui.view">
        <field name="name">purchase.advance.payment.wizard.form</field>
        <field name="model">purchase.advance.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Advance Payment">
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="available_payment_method_line_ids" invisible="1"/>
                <group>
                    <group name="order">
                        <field name="purchase_order_id"/>
                        <field name="partner_id"/>
                        <field name="order_amount_total"/>
                        <field name="advance_payment_total"/>
                        <field name="available_amount" class="fw-bold"/>
                    </group>
                    <group name="payment">
                        <field name="amount"/>
                        <field name="journal_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="payment_method_line_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="payment_date"/>
                        <field name="memo"/>
                    </group>
                </group>
                <div class="text-muted">
                    A draft vendor payment is created on the prepayment account. Post it to count it as an advance;
                    vendor bills of this order will then deduct it proportionally.
                </div>
                <footer>
                    <button name="action_create_payment" type="object" string="Create Draft Payment"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
